#!/usr/bin/env python3
"""claude-chat-picker: list this folder's Claude Code chats, resume one or rename it.

  claude-chat-picker              resume with --dangerously-skip-permissions
  claude-chat-picker --no-perms   resume without it
  claude-chat-picker --dir PATH   use another folder's chats
  claude-chat-picker --stats      tokens used and chats renamed by this tool (and the nudge mod)
  claude-chat-picker --new        start a new chat (with --dangerously-skip-permissions)
  claude-chat-picker --new --no-perms   start a new chat without it

Renaming writes what /rename writes (a custom-title row in the transcript plus
<session>/custom-title.json). The suggested name comes from Sonnet, reading a
digest of the chat, and follows ~/.claude/chat-naming.json.
"""
import argparse
import json
import os
import re
import shlex
import shutil
import subprocess
import sys
import tempfile
import time
from datetime import datetime

MODEL = "claude-sonnet-5-5"
PROJECTS = os.path.expanduser("~/.claude/projects")
CONVENTIONS = os.path.expanduser("~/.claude/chat-naming.json")
CACHE_DIR = os.path.expanduser("~/.cache/claude-chat-picker")
CACHE_VERSION = 1
# Shared with the chat-name-nudge mod: one JSON row per model call and per rename.
STATS = os.path.expanduser("~/.claude/chat-naming-stats.jsonl")
SID_RE = re.compile(r"^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$")
# Control characters (incl. ESC): transcript text and model output are untrusted and must not
# reach the terminal as escape sequences, or a title as a newline.
CTRL_RE = re.compile(r"[\x00-\x1f\x7f-\x9f\u200b-\u200f\u202a-\u202e\u2066-\u2069]")

DIM, BOLD, RESET = "\033[2m", "\033[1m", "\033[0m"


def clean(s):
    return CTRL_RE.sub(" ", s or "")


def private_open(path, mode):
    """Open a file readable only by this user (the cache and stats hold chat excerpts/titles)."""
    fd = os.open(path, (os.O_WRONLY | os.O_CREAT | (os.O_APPEND if "a" in mode else os.O_TRUNC)), 0o600)
    return os.fdopen(fd, mode)


def log_stat(row):
    row = {"ts": datetime.now().astimezone().isoformat(timespec="seconds"), "source": "cli", **row}
    try:
        with private_open(STATS, "a") as f:
            f.write(json.dumps(row, ensure_ascii=False) + "\n")
    except OSError:
        pass


def slug_for(path):
    return re.sub(r"[^A-Za-z0-9]", "-", path)


# ---------- reading transcripts ----------

def prompt_text(row):
    """The person's typed text in a user row, or None for tool results / meta rows."""
    if row.get("isMeta") or row.get("isSidechain"):
        return None
    content = (row.get("message") or {}).get("content")
    if isinstance(content, list):
        parts = [b.get("text", "") for b in content if isinstance(b, dict) and b.get("type") == "text"]
        if not parts:
            return None
        content = "\n".join(parts)
    if not isinstance(content, str):
        return None
    text = content.strip()
    m = re.search(r"<command-name>(.*?)</command-name>", text)
    if m:
        args = re.search(r"<command-args>(.*?)</command-args>", text, re.S)
        return (m.group(1) + " " + (args.group(1) if args else "")).strip()
    if text.startswith(("<local-command", "<system-reminder", "Caveat:", "[Request interrupted", "<task-notification",
                        "<bash-", "This session is being continued")):
        return None
    text = re.sub(r"<pasted_content[^>]*>", "", text).replace("</pasted_content>", "")
    text = re.sub(r"\[Image #\d+\]", "", text).strip()
    return text or None


def scan(path):
    info = {"custom": None, "agent": None, "ai": None, "prompts": [], "replies": [],
            "tools": {}, "first": None, "last": None, "cwd": None}
    with open(path, "r", errors="replace") as f:
        for line in f:
            if '"type":"' not in line:
                continue
            # skip parsing the bulky rows we never need
            if '"type":"attachment"' in line[:200] or '"file-history' in line[:80]:
                continue
            try:
                row = json.loads(line)
            except ValueError:
                continue
            t = row.get("type")
            ts = row.get("timestamp")
            if ts:
                info["first"] = info["first"] or ts
                info["last"] = ts
            if row.get("cwd") and not info["cwd"]:
                info["cwd"] = row["cwd"]
            if t == "custom-title":
                info["custom"] = row.get("customTitle") or None
            elif t == "agent-name":
                info["agent"] = row.get("agentName") or None
            elif t == "ai-title":
                info["ai"] = row.get("aiTitle") or None
            elif t == "user":
                p = prompt_text(row)
                if p:
                    info["prompts"].append(p[:600])
            elif t == "assistant" and not row.get("isSidechain"):
                for b in (row.get("message") or {}).get("content") or []:
                    if not isinstance(b, dict):
                        continue
                    if b.get("type") == "text" and b.get("text", "").strip():
                        info["replies"].append(b["text"].strip()[:400])
                    elif b.get("type") == "tool_use":
                        name = b.get("name", "?")
                        info["tools"][name] = info["tools"].get(name, 0) + 1
    # keep the cache small: first/last few of each
    info["prompts"] = info["prompts"][:12] + info["prompts"][12:][-8:]
    info["replies"] = info["replies"][:3] + info["replies"][3:][-5:]
    return info


def title_json(proj, sid):
    p = os.path.join(proj, sid, "custom-title.json")
    try:
        with open(p) as f:
            return json.load(f).get("customTitle") or None
    except (OSError, ValueError):
        return None


def load_chats(proj):
    os.makedirs(CACHE_DIR, mode=0o700, exist_ok=True)
    cache_path = os.path.join(CACHE_DIR, os.path.basename(proj) + ".json")
    try:
        with open(cache_path) as f:
            cache = json.load(f)
        if cache.get("v") != CACHE_VERSION:
            cache = {}
    except (OSError, ValueError):
        cache = {}
    entries = cache.get("entries", {})
    chats, fresh = [], {}
    for name in os.listdir(proj):
        if not name.endswith(".jsonl"):
            continue
        sid = name[:-6]
        path = os.path.join(proj, name)
        st = os.stat(path)
        key = f"{st.st_mtime_ns}:{st.st_size}"
        hit = entries.get(sid)
        if hit and hit.get("key") == key:
            info = hit["info"]
        else:
            info = scan(path)
        fresh[sid] = {"key": key, "info": info}
        if not info["prompts"]:
            continue  # empty chats (opened and closed) aren't worth listing
        chats.append({"id": sid, "path": path, "size": st.st_size, "mtime": st.st_mtime,
                      "title": title_json(proj, sid) or info["custom"] or info["agent"], **info})
    try:
        with private_open(cache_path, "w") as f:
            json.dump({"v": CACHE_VERSION, "entries": fresh}, f)
    except OSError:
        pass
    chats.sort(key=lambda c: c["mtime"], reverse=True)
    return chats


# ---------- conventions + model ----------

def conventions_for(folder):
    try:
        with open(CONVENTIONS) as f:
            conf = json.load(f)
    except (OSError, ValueError):
        conf = {}
    text = conf.get("default") or "3-7 words, lowercase, no trailing period. Say what the chat is about."
    best = ""
    for prefix in (conf.get("folders") or {}):
        p = prefix.rstrip("/")
        if (folder == p or folder.startswith(p + "/")) and len(p) > len(best):
            best = p
    if best:
        text += "\n" + conf["folders"][best if best in conf["folders"] else best + "/"]
    return text


def digest(chat):
    lines = [f"Folder: {chat.get('cwd') or '?'}"]
    if chat.get("ai"):
        lines.append(f"Auto-generated title (often vague): {chat['ai']}")
    lines.append("What the person asked, in order:")
    lines += [f"- {p[:500]}" for p in chat["prompts"]]
    if chat["tools"]:
        top = sorted(chat["tools"].items(), key=lambda kv: -kv[1])[:8]
        lines.append("Tools used: " + ", ".join(f"{k}×{v}" for k, v in top))
    if chat["replies"]:
        lines.append("Some of the assistant's replies:")
        lines += [f"- {r[:300]}" for r in chat["replies"]]
    return "\n".join(lines)[:9000]


def suggest_names(chat, avoid=(), hint=""):
    folder = chat.get("cwd") or os.getcwd()
    prompt = (
        "You name Claude Code chats so the person can find them later in a list.\n\n"
        f"Naming conventions:\n{conventions_for(folder)}\n\n"
        f"Chat digest:\n{digest(chat)}\n\n"
        + (f"The person's direction for the name (follow it closely, while staying accurate "
           f"to the chat and the conventions): {hint}\n\n" if hint else "")
        + (f"Do not repeat these earlier suggestions: {', '.join(avoid)}\n\n" if avoid else "")
        + "Give 3 different candidate names, most accurate first, one per line, "
        "nothing else: no numbering, no quotes, no commentary. Base them on what the "
        "chat actually covered across the WHOLE conversation, not just the end. If it covered "
        "two unrelated topics, join them with ' + ' (e.g. 'mx master fix + open source tool hunt'). "
        "Never use the folder's own name as the project name."
    )
    with tempfile.TemporaryDirectory() as scratch:
        try:
            out = subprocess.run(
                # no tools, no MCP, no saved session, run from an empty temp dir: the model
                # only reads the digest and returns text
                ["claude", "-p", "--model", MODEL, "--no-session-persistence",
                 "--tools", "", "--strict-mcp-config", "--effort", "low", "--output-format", "json"],
                input=prompt, capture_output=True, text=True, timeout=90, cwd=scratch)
        except (OSError, subprocess.TimeoutExpired) as e:
            return [], str(e)
    try:
        res = json.loads(out.stdout)
    except ValueError:
        return [], (out.stderr.strip() or out.stdout.strip())[:300]
    u = res.get("usage") or {}
    log_stat({"kind": "model", "model": MODEL, "session": chat["id"],
              "in": u.get("input_tokens", 0), "out": u.get("output_tokens", 0),
              "cache_read": u.get("cache_read_input_tokens", 0),
              "cache_write": u.get("cache_creation_input_tokens", 0),
              "cost_usd": res.get("total_cost_usd", 0)})
    if res.get("is_error"):
        return [], clean(str(res.get("result")))[:300]
    names = []
    for line in clean_lines(res.get("result") or ""):
        line = re.sub(r"^\s*(?:[-*•]|\d+[.)])\s*", "", line).strip().rstrip(".").strip('"\'`').rstrip(".")
        if line and len(line) <= 80 and line not in names:
            names.append(line)
    return names[:3], ("" if names else "empty reply")


def clean_lines(text):
    return [clean(l) for l in text.splitlines()]


def write_title(proj, sid, title):
    """Exactly what /rename writes."""
    title = " ".join(clean(title).split())[:120]
    if not SID_RE.match(sid):
        raise ValueError(f"not a session id: {sid!r}")
    row = {"type": "custom-title", "customTitle": title, "sessionId": sid}
    with open(os.path.join(proj, sid + ".jsonl"), "a") as f:
        f.write(json.dumps(row, ensure_ascii=False, separators=(",", ":")) + "\n")
    os.makedirs(os.path.join(proj, sid), exist_ok=True)
    with open(os.path.join(proj, sid, "custom-title.json"), "w") as f:
        json.dump({"customTitle": title}, f, ensure_ascii=False)
    return title


# ---------- UI ----------

def when(ts):
    d = time.time() - ts
    if d < 3600:
        return f"{int(d // 60)}m ago"
    if d < 86400:
        return f"{int(d // 3600)}h ago"
    if d < 7 * 86400:
        return f"{int(d // 86400)}d ago"
    return datetime.fromtimestamp(ts).strftime("%d %b")


def size(n):
    return f"{n / 1e6:.1f}M" if n >= 1e6 else f"{n // 1000}K"


def one_line(s, n):
    s = " ".join(clean(s).split())
    return s if len(s) <= n else s[: n - 1] + "…"


def label(c):
    if c["title"]:
        return f"{BOLD}{one_line(c['title'], 60)}{RESET}"
    hint = c["ai"] or c["prompts"][0]
    return f"{DIM}(unnamed){RESET} {one_line(hint, 60)}"


def fzf(lines, header, prompt="> ", preview=None, expect=None):
    cmd = ["fzf", "--ansi", "--no-sort", "--reverse", "--height=90%", "--border=rounded",
           "--delimiter=\t", "--with-nth=2..", "--header", header, "--prompt", prompt,
           "--color=hl:white:bold,hl+:white:bold,pointer:white,prompt:white,header:gray,border:gray"]
    if preview:
        cmd += ["--preview", preview, "--preview-window=down,45%,wrap"]
    if expect:
        cmd += ["--expect", expect]
    r = subprocess.run(cmd, input="\n".join(lines), capture_output=True, text=True)
    if r.returncode != 0:
        return None, None
    out = r.stdout.rstrip("\n").split("\n")
    if expect:
        key, pick = out[0], (out[1] if len(out) > 1 else "")
    else:
        key, pick = "", out[0]
    return key, pick.split("\t", 1)[0] if pick else None


def preview_cmd(proj):
    # fzf preview runs this same script in --preview mode
    # fzf substitutes {1} already shell-quoted; quote our own parts too (paths can hold spaces)
    q = shlex.quote
    return f"{q(sys.executable)} {q(os.path.abspath(__file__))} --_preview {q(proj)} {{1}}"


def show_preview(proj, sid):
    if not SID_RE.match(sid) or os.path.dirname(os.path.realpath(proj)) != os.path.realpath(PROJECTS):
        return
    chats = {c["id"]: c for c in load_chats(proj)}
    c = chats.get(sid)
    if not c:
        return
    print(f"{BOLD}{one_line(c['title'] or '(unnamed)', 100)}{RESET}   {DIM}{sid}{RESET}")
    if c["ai"] and not c["title"]:
        print(f"{DIM}auto title:{RESET} {one_line(c['ai'], 100)}")
    print(f"{DIM}{when(c['mtime'])} · {size(c['size'])} · {len(c['prompts'])}+ prompts{RESET}\n")
    for p in c["prompts"][:10]:
        print(f"› {one_line(p, 220)}")


def choose_chat(proj, chats, header):
    lines = [f"{c['id']}\t{label(c)}  {DIM}{when(c['mtime'])} · {size(c['size'])}{RESET}" for c in chats]
    key, sid = fzf(lines, header, preview=preview_cmd(proj), expect="ctrl-r,ctrl-o")
    return key, next((c for c in chats if c["id"] == sid), None)


def rename_flow(proj, chat):
    print(f"\n{BOLD}Renaming{RESET} {chat['title'] or '(unnamed)'}  {DIM}{chat['id']}{RESET}")
    if time.time() - chat["mtime"] < 120:
        print(f"{DIM}Note: this chat was active in the last 2 minutes. If it is open somewhere, "
              f"the new name shows there after it's reopened.{RESET}")
    seen, hint = [], ""
    while True:
        print(f"{DIM}Asking Sonnet for a name…{RESET}", flush=True)
        if hint:
            print(f"{DIM}Direction: {hint}{RESET}")
        names, err = suggest_names(chat, seen, hint)
        if not names:
            print(f"No suggestion came back. {err}")
        seen += names
        opts = [f"use:{n}\t{BOLD}{n}{RESET}" for n in names]
        opts += ["again\t↻ suggest different names",
                 "hint\t✦ suggest from my direction…  " + (f"{DIM}(now: {one_line(hint, 40)}){RESET}" if hint else f"{DIM}e.g. 'mention the client', 'shorter'{RESET}"),
                 "type\t✎ type my own name", "cancel\t✕ cancel"]
        _, pick = fzf(opts, "Pick a name for this chat (Sonnet suggestions)", prompt="name> ")
        if pick in (None, "cancel"):
            return False
        if pick == "hint":
            got = input("Direction for the name (Enter to keep the current one): ").strip()
            if got:
                hint, seen = got, []  # new direction: earlier names needn't be avoided
            continue
        if pick == "again":
            continue
        if pick == "type":
            title = input("Name: ").strip()
        else:
            # pre-fill so it can be tweaked; plain Enter keeps it
            title = edit_line(pick[4:])
        if not title:
            return False
        title = write_title(proj, chat["id"], title)
        chat["title"] = title
        how = "typed" if pick == "type" else ("suggested+direction" if hint else "suggested")
        log_stat({"kind": "rename", "session": chat["id"], "folder": chat.get("cwd"), "title": title, "how": how})
        print(f"✓ Renamed to {BOLD}{title}{RESET}")
        time.sleep(0.8)
        return True


def edit_line(default):
    """Enter keeps the suggestion; anything typed replaces it."""
    got = input(f"Name [{BOLD}{default}{RESET}] (Enter to keep, or type a new one): ").strip()
    return got or default


def resume(chat, no_perms, folder):
    cmd = ["claude"] + ([] if no_perms else ["--dangerously-skip-permissions"]) + ["--resume", chat["id"]]
    print(f"{DIM}$ {' '.join(cmd)}{RESET}")
    os.chdir(folder)  # --resume looks the id up under this folder's project dir
    os.execvp("claude", cmd)


def show_stats():
    rows = []
    try:
        with open(STATS) as f:
            for line in f:
                try:
                    rows.append(json.loads(line))
                except ValueError:
                    pass
    except OSError:
        pass
    calls = [r for r in rows if r.get("kind") == "model"]
    renames = [r for r in rows if r.get("kind") == "rename"]
    if not rows:
        print(f"No usage recorded yet ({STATS}).")
        return
    print(f"{BOLD}claude-chat-picker + chat-name-nudge usage{RESET}  {DIM}since {rows[0].get('ts', '?')[:10]}{RESET}\n")
    print(f"{BOLD}Name suggestions{RESET} (model calls on your subscription)")
    for src in ("cli", "mod"):
        cs = [r for r in calls if r.get("source") == src]
        if not cs:
            continue
        tin = sum(r.get("in", 0) for r in cs)
        tcr = sum(r.get("cache_read", 0) for r in cs)
        tcw = sum(r.get("cache_write", 0) for r in cs)
        tout = sum(r.get("out", 0) for r in cs)
        cost = sum(r.get("cost_usd") or 0 for r in cs)
        name = "picker (CLI)" if src == "cli" else "nudge (mod) "
        models = ", ".join(sorted({r.get("model", "?") for r in cs}))
        print(f"  {name}  {len(cs):>4} calls · {tin + tcr + tcw:>9,} tokens in · {tout:>7,} out"
              f"{f' · ~${cost:.2f} at API prices' if cost else ''}  {DIM}{models}{RESET}")
    tot_in = sum(r.get("in", 0) + r.get("cache_read", 0) + r.get("cache_write", 0) for r in calls)
    tot_out = sum(r.get("out", 0) for r in calls)
    print(f"  {'total':<12}  {len(calls):>4} calls · {tot_in:>9,} tokens in · {tot_out:>7,} out")
    print(f"  {DIM}On a Max/Pro subscription this counts toward your usage limits; it isn't billed. "
          f"The $ is what the API would have charged.{RESET}\n")
    print(f"{BOLD}Chats renamed{RESET}: {len(renames)}")
    for src, label_ in (("cli", "from the picker"), ("mod", "via the nudge (/rename)")):
        n = sum(1 for r in renames if r.get("source") == src)
        if n:
            print(f"  {label_}: {n}")
    hows = {}
    for r in renames:
        hows[r.get("how", "?")] = hows.get(r.get("how", "?"), 0) + 1
    if hows:
        print("  " + " · ".join(f"{k}: {v}" for k, v in sorted(hows.items())))
    if renames:
        print(f"\n{BOLD}Latest renames{RESET}")
        for r in renames[-8:][::-1]:
            folder = os.path.basename(r.get("folder") or "") or "?"
            print(f"  {DIM}{r.get('ts', '')[:16].replace('T', ' ')}  {one_line(folder, 18):<18}{RESET} {one_line(r.get('title', ''), 70)}")


def main():
    ap = argparse.ArgumentParser(description="Pick a Claude chat in this folder to resume or rename.")
    ap.add_argument("--no-perms", action="store_true", help="resume without --dangerously-skip-permissions")
    ap.add_argument("--stats", action="store_true", help="show model tokens used and chats renamed by this tool")
    ap.add_argument("--new", action="store_true", help="start a new chat here instead of picking one")
    ap.add_argument("--dir", default=os.getcwd(), help="folder whose chats to list (default: here)")
    ap.add_argument("--_preview", nargs=2, help=argparse.SUPPRESS)
    a = ap.parse_args()

    if a._preview:
        show_preview(*a._preview)
        return
    if a.stats:
        show_stats()
        return
    if a.new:
        cmd = ["claude"] + ([] if a.no_perms else ["--dangerously-skip-permissions"])
        print(f"{DIM}$ {' '.join(cmd)}{RESET}")
        os.chdir(os.path.realpath(a.dir))
        os.execvp("claude", cmd)
    if not shutil.which("fzf"):
        sys.exit("claude-chat-picker needs fzf (brew install fzf)")

    folder = os.path.realpath(a.dir)
    proj = os.path.join(PROJECTS, slug_for(folder))
    if not os.path.isdir(proj):
        sys.exit(f"No Claude chats for {folder}")
    chats = load_chats(proj)
    if not chats:
        sys.exit(f"No Claude chats for {folder}")
    mode = "" if a.no_perms else " (skip permissions)"

    # Esc in a chat list goes back to this menu; Esc here quits.
    # Renaming never opens the chat: it returns to the list so more can be renamed or one opened.
    while True:
        unnamed = sum(1 for c in chats if not c["title"])
        _, action = fzf(
            [f"resume\t▶  Pick a chat to resume{mode}",
             f"rename\t✎  Rename an existing chat   {DIM}{unnamed} of {len(chats)} unnamed{RESET}"],
            f"{folder}", prompt="› ")
        if action is None:
            return
        while True:
            if action == "resume":
                key, chat = choose_chat(proj, chats, f"Enter: resume{mode} · Ctrl-R: rename · Esc: back")
            else:
                ordered = sorted(chats, key=lambda c: (bool(c["title"]), -c["mtime"]))
                key, chat = choose_chat(proj, ordered, f"Enter: rename (unnamed first) · Ctrl-O: open{mode} · Esc: back")
            if not chat:
                break
            wants_rename = (key == "ctrl-r") if action == "resume" else (key != "ctrl-o")
            if wants_rename:
                rename_flow(proj, chat)
                continue
            resume(chat, a.no_perms, folder)


if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        print()
